{
  "schemaVersion": "1.0",
  "contextRules": [
    {
      "match": {
        "contextType": "task_outcome"
      },
      "distributions": [
        {
          "id": "task_outcome.status",
          "facetKey": "outcome_status",
          "title": "Kết quả chấm"
        },
        {
          "id": "task_outcome.profile_switched",
          "facetKey": "profile_switched",
          "title": "Profile có đổi thật không"
        },
        {
          "id": "task_outcome.assistant_replied",
          "facetKey": "assistant_replied",
          "title": "Trợ lý có trả lời"
        }
      ]
    },
    {
      "match": {
        "contextType": "assistant_mode"
      },
      "distributions": [
        {
          "id": "assistant_mode.by_profile",
          "facetKey": "assistant_profile_id",
          "title": "Profile trợ lý"
        },
        {
          "id": "assistant_mode.by_vehicle_state",
          "facetKey": "vehicle_state",
          "title": "Trạng thái xe"
        },
        {
          "id": "assistant_mode.reply_length",
          "facetKey": "reply_char_count",
          "title": "Độ dài phản hồi"
        },
        {
          "id": "assistant_mode.replied",
          "facetKey": "replied",
          "title": "Có phản hồi"
        },
        {
          "id": "assistant_mode.profile_applied",
          "facetKey": "profile_applied",
          "title": "Profile có hiệu lực"
        },
        {
          "id": "assistant_mode.by_parent_intent",
          "facetKey": "parent_intent_code",
          "title": "Nhóm intent"
        }
      ]
    },
    {
      "match": {
        "contextType": "user_feedback"
      },
      "distributions": [
        {
          "id": "user_feedback.rating_by_segment",
          "facetKey": "overall_experience_rating",
          "title": "Overall experience rating"
        },
        {
          "id": "user_feedback.need_satisfaction",
          "facetKey": "need_constraint_satisfaction",
          "title": "Need satisfaction"
        }
      ]
    }
  ]
}
